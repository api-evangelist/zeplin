          "name": "Get project variable collections",
          "request": {
            "name": "Get project variable collections",
            "description": {
              "content": "This endpoint returns all of the color variables in a project\n\nYou need to be a member of the project or a member of the organization that owns the project. Returns `Not Found` response otherwise.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "projects",
                ":project_id",
                "variable_collections"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "30",
                  "description": "Pagination limit"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset"
                },
                {
                  "disabled": false,
                  "key": "include_linked_styleguides",
