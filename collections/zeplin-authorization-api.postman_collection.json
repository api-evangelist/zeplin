          "name": "Authorization endpoint",
          "request": {
            "name": "Authorization endpoint",
            "description": {
              "content": "Users are redirected to web app to authenticate themselves and authorize the app with `client_id` to act on behalf of themselves.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth",
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) Only `code` flow is supported"
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Identifier of the Zeplin app requesting user authentication"
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "(Required) User is redirected to this endpoint after authorization"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "RECOMMENDED. An opaque value used by the client to maintain state between the request and callback."
                },
                {
                  "disabled": false,
                  "key": "code_challenge",
                  "value": "<string>",
                  "description": "RECOMMENDED. A PKCE code challenge derived from the code verifier, to be verified against later."
                },
                {
                  "disabled": false,
                  "key": "code_challenge_method",
                  "value": "S256",
                  "description": "RECOMMENDED. PKCE code verifier transformation method."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
