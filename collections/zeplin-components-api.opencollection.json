            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project id"
              },
              {
                "name": "component_id",
                "value": "",
                "type": "path",
                "description": "Component id"
              },
              {
                "name": "include_latest_version",
                "value": "",
                "type": "query",
                "description": "Whether to include the latest version data in the Component object"
